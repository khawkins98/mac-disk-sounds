{
  "name": "mac-disk-sounds",
  "version": "1.0.1-alpha.3",
  "description": "Retro HDD sound effects for disk activity",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -mwl",
    "build:mac": "electron-builder -m",
    "build:win": "electron-builder -w",
    "build:linux": "electron-builder -l",
    "release": "electron-builder -mwl -p always"
  },
  "build": {
    "appId": "com.macdisksounds.app",
    "productName": "Mac Disk Sounds",
    "publish": {
      "provider": "github",
      "owner": "khawkins98",
      "repo": "mac-disk-sounds",
      "releaseType": "release"
    },
    "files": [
      "package.json",
      "main.js",
      "renderer.js",
      "index.html",
      "vendor/system.css/**",
      "sounds/*.mp3",
      "icon.iconset/icon_256x256.png"
    ],
    "asar": true,
    "asarUnpack": [
      "sounds/*.mp3"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icon.iconset/icon_256x256.png",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "maintainer": "Mac Disk Sounds Team",
      "description": "Bring back the nostalgic sounds of vintage hard drives"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "keywords": [
    "electron",
    "mac",
    "windows",
    "linux",
    "disk",
    "sounds",
    "retro"
  ],
  "author": "Ken Hawkins",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "systeminformation": "^5.33.15"
  }
}
